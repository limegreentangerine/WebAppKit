#!/usr/bin/env php
<?php

declare(strict_types=1);

if (!isset($_composer_autoload_path)) {
    fwrite(STDERR, "This command must be run through Composer.\n");
    exit(1);
}

$filename = 'web-app-service-worker.js';

$packageDirectory = dirname(__DIR__);
$source = $packageDirectory . '/resources/' . $filename;

$projectRoot = dirname($_composer_autoload_path);
$destination = $projectRoot . '/../public/' . $filename;

if (!is_file($source)) {
    fwrite(STDERR, "Source file does not exist: {$source}\n");
    exit(1);
}

if (!copy($source, $destination)) {
    fwrite(STDERR, "Unable to copy: {$source}\n");
    exit(1);
}

echo "Copied: " . basename($source) . " to " . $destination . PHP_EOL;
echo "WebAppKit Service Worker installed.\n";
