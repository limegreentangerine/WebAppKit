{
	"name": "limegreentangerine/web_app",
	"description": "Add standalone web app functionality to a website",
	"type": "concrete5-package",
	"license": "proprietary",
	"minimum-stability": "stable",
	"autoload": {
		"psr-4": {
			"WebApp\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WebApp\\Tests\\": "tests/"
		}
	},
	"authors": [
		{
			"name": "Lee Jones",
			"email": "prolific.jones82@gmail.com"
		}
	],
	"require-dev": {
		"php": "^8.4",
		"phpunit/phpunit": "^11",
		"concrete5/core": "^9.2",
		"friendsofphp/php-cs-fixer": "^3.95"
	},
	"config": {
		"allow-plugins": {
			"mlocati/composer-patcher": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"test-coverage": "phpunit --coverage-text",
		"format:php": "php-cs-fixer fix",
		"format:php:check": "php-cs-fixer check --diff",
		"format:js": "npx prettier --write .",
		"format:js:check": "npx prettier --check .",
		"format": [
			"@format:php",
			"@format:js"
		],
		"format:check": [
			"@format:php:check",
			"@format:js:check"
		],
		"post-install-cmd": [
			"npm install"
		]
	}
}
